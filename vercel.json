{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/api/credits(?:/(.*))?$", "dest": "/api/credits-fixed" },
    { "src": "^/api/generate(?:/(.*))?$", "dest": "/api/generate-fast" },
    { "src": "^/api/billing/checkout$", "dest": "/api/checkout" },
    { "src": "^/api/billing/webhook$", "dest": "/api/webhook" },
    { "src": "^/api/billing/reconcile$", "dest": "/api/reconcile" },
    { "handle": "filesystem" }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
