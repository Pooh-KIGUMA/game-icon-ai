{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/global.html" },
    { "src": "^/api/credits(?:/(.*))?$", "dest": "/api/credits-fixed" },
    { "handle": "filesystem" }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
