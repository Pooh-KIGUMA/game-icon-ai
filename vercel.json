{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "functions": {
    "api/*.js": { "maxDuration": 300 }
  },
  "routes": [
    { "src": "^/$", "dest": "/global.html" },
    { "src": "^/api/generate$", "dest": "/api/generate-protected.js" },
    { "handle": "filesystem" }
  ]
}
